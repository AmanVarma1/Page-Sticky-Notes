{
  "manifest_version": 3,
  "name": "Page Sticky Notes",
  "version": "2.1.0",
  "description": "Add sticky notes and text highlights to web pages, with backup, sync, reminders and a Groq-powered AI assistant.",
  "permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Page Sticky Notes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "add-note": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Add a sticky note to this page"
    },
    "highlight-note": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Highlight the selected text and attach a note"
    },
    "toggle-notes": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Show or hide sticky notes on this page"
    }
  },
  "host_permissions": [
    "https://api.groq.com/*"
  ]
}
